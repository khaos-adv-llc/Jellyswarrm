platform :ios, '26.0'
platform :tvos, '26.0'

use_frameworks!

# Workspace name matches the Xcode workspace
workspace 'Jellyswarm'

# iOS target
target 'Jellyswarm' do
  platform :ios, '26.0'
  pod 'MobileVLCKit', '~> 3.3'
end

# tvOS target
target 'Jellyswarrm-tvOS' do
  platform :tvos, '26.0'
  pod 'TVVLCKit', '~> 3.3'
end

# macOS target
target 'Jellyswarrm-macOS' do
  platform :macos, '26.0'
  pod 'VLCKit', '~> 3.3'
end
